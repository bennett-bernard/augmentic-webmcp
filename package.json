{
  "name": "augmentic-webmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Computer-use form tests with GPT-6 Astra, the Agents SDK, and sandboxed Playwright code execution.",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "test": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test agent.spec.mjs",
    "test:smoke": "playwright test smoke.spec.mjs",
    "sandbox:build": "docker build -f sandbox/Dockerfile -t augmentic-browser-runtime:local ."
  },
  "dependencies": {
    "@openai/agents": "0.17.2",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
